security:
  default:
    containerSecurityContext:
      enabled: false

    podSecurityContext:
      enabled: false

application:
  grist:
    enabled: false
    namespace: default 

  ollama:
    enabled: false
    namespace: icbr-poc-ollama

  keycloak:
    enabled: true 
    namespace: default 
    extraEnvVars:
      - name: KC_PROXY_HEADERS
        value: "x-forwarded"
      - name: KC_HOSTNAME_STRICT
        value: "false"
      - name: KC_HOSTNAME_BACKCHANNEL_DYNAMIC
        value: "true"
      - name: KC_HTTP_ENABLED
        value: "true"

  openproject:
    enabled: false
    namespace: icbr-poc-openproject

  element:
    enabled: false
    namespace: icbr-poc-element

  nextcloud:
    enabled: true 
    namespace: default 
    oidc: 
      discoveryUri: "http://keycloak-keycloak/realms/mijnbureau/.well-known/openid-configuration"

  collabora:
    enabled: false
    namespace: default 
    enableInsecureCoolWSD: true

  livekit:
    enabled: false
    namespace: default

  meet:
    enabled: false
    namespace: default 

  conversations:
    enabled: false
    namespace: default 

  docs:
    enabled: false
    namespace: default 
    authorizationServicesEnabled: false 
    backend:
      networkPolicy:
        extraEgress:
          - ports:
              - port: 80 
            to:
              - podSelector:
                  matchLabels:
                    app.kubernetes.io/name: keycloak



  bureaublad:
    enabled: true 
    namespace: default 
    authorizationServicesEnabled: false

  drive:
    enabled: false
    namespace: default 
    authorizationServicesEnabled: true 
    serviceAccountsEnabled: true 
    readinessProbe:
      timeoutSeconds: 20

  clamav:
    enabled: false
    namespace: default 

