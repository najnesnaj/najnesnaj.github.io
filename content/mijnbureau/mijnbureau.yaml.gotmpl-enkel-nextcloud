    meet:
      backend:
        minReplicas: 1
      frontend:
        minReplicas: 1
    conversations:
      backend:
        minReplicas: 1
      frontend:
        minReplicas: 1
    bureaublad:
      backend:
        minReplicas: 1
      frontend:
        minReplicas: 1
    drive:
