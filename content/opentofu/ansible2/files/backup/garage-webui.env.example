# Reference copy. Installed at LXC /etc/garage-webui.env (root-only, 0600).
# The real file contains the bcrypt password hash; it is not reproduced here.
#
# AUTH_USER_PASS is "user:bcrypt_hash". Generate a hash on the LXC
# (apache2-utils is installed there):
#
#   htpasswd -nbBC 10 admin 'new-password'
#
# Make the login work in garage-webui (Go accepts only $2a$/$2b$; htpasswd
# emits $2y$), then replace the prefix and write the file:
#
#   htpasswd -nbBC 10 admin 'new-password' | tr -d '\n' | sed 's/\$2y\$/\$2b\$/'
#
AUTH_USER_PASS=admin:<bcrypt-hash>
PORT=3909
CONFIG_PATH=/etc/garage.toml
